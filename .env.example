# Copy to .env.local (not committed) and set to your computer's address on the same Wi-Fi as your phone.
# The backend prints this "Network" URL when it starts.
#   iOS simulator / web: http://localhost:4000
#   Android emulator:    http://10.0.2.2:4000
#   Real phone:          http://<your-computer-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
