{
  "name": "ridzo-backend",
  "version": "1.0.0",
  "description": "Ridzo API (Node.js + Express + Supabase)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sms:test": "tsx src/scripts/sendTestSms.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start:prod": "node --enable-source-maps dist/server.js"
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
