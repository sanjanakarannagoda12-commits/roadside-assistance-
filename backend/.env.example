# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# memory   = no setup, data lost on restart (quick test)
# supabase = real database (run supabase/migrations/001_init.sql first)
DB_DRIVER=memory
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Settings → API Keys → service_role (secret!)
SUPABASE_STORAGE_BUCKET=mechanic-documents

# Long random strings. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
OTP_SECRET=

# console = print codes in this terminal (free). textlk = send real SMS via Text.lk.
SMS_PROVIDER=console
# Text.lk dashboard → Developers → API Token
TEXTLK_API_TOKEN=
# Your approved sender ID (max 11 chars), e.g. RIDZO. Request it under Sending → Sender ID.
# "TextLKDemo" works for a quick test only — Text.lk forbids it for OTPs/production.
TEXTLK_SENDER_ID=

# Enables POST /dev/review to approve/reject mechanics while testing.
ENABLE_DEV_ROUTES=true

# ─── Google Maps (optional) ─────────────────────────────────────────────────
# Real road distance + traffic-aware ETA for matching, travel charges and "X min away".
# Without a key, distance is estimated (straight line × road factor from the admin Pricing page).
# Google Cloud console → enable "Routes API" → Credentials → API key → restrict it to the Routes API.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TRAFFIC=true
